---
import { Swiper, SwiperWrapper, SwiperSlide, SwiperButtonPrev, SwiperButtonNext } from "astro-swiper";
import { Star, Calendar } from "@lucide/astro";

import { getMovieList } from "../lib/movies";
import AvisoDegradado from "./AvisoDegradado.astro";

const { movies, degraded } = await getMovieList(
  "/trending/movie/week?language=es-ES",
  6,
  "w1280",
);

function truncate(text: string, max = 100) {
  return text.length > max ? text.slice(0, max) + "..." : text;
}
---

<script>
  // Detener autoplay del hero para usuarios con prefers-reduced-motion
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const stop = () => {
      const el = document.querySelector('astro-swiper') as any;
      if (el?.astroSwiper) {
        el.astroSwiper.autoplay?.stop();
      } else {
        requestAnimationFrame(stop);
      }
    };
    stop();
  }
</script>

<h1 class="sr-only">Cinerama - Cartelera</h1>

{
  movies.length > 0 && (
    <Swiper
      options={{
        autoplay: {
          delay: 4000,
          disableOnInteraction: false,
          waitForTransition: false,
        },
        loop: true,
        navigation: {
          nextEl: ".swiper-button-next",
          prevEl: ".swiper-button-prev",
        },
      }}
    >
      <SwiperWrapper>
        {movies.map((movie) => (
          <SwiperSlide>
            <div class="relative w-screen h-screen">
              <img
                src={movie.image}
                class="w-full h-full object-cover"
                alt={movie.title}
                loading="eager"
                decoding="async"
                width="1280"
                height="720"
              />

              <div class="absolute bottom-0 left-0 w-full h-40 bg-gradient-to-t from-black to-transparent pointer-events-none"></div>

              <div class="absolute inset-0 flex flex-col justify-center items-start text-white bg-black/70 px-16">
                <h2 class="text-3xl md:text-5xl lg:text-7xl font-bold">{movie.title}</h2>
                <p class="text-sm md:text-lg mt-2">
                  {movie.overview ? truncate(movie.overview) : "Sin sinopsis disponible."}
                </p>

                <div class="flex flex-wrap items-center gap-4 mt-2 mb-4 text-sm">
                  <div class="flex items-center space-x-2">
                    <Calendar size={16} class="text-cine-rojo-vivo" aria-hidden="true" />
                    <span class="uppercase text-zinc-300">{movie.releaseLabel}</span>
                  </div>
                  <div class="flex items-center space-x-2">
                    <Star size={16} class="text-cine-oro" aria-hidden="true" />
                    <span class="text-zinc-300">{movie.ratingLabel}</span>
                  </div>
                  <span class="rounded border border-cine-oro/40 bg-cine-oro/10 px-2 py-1 text-xs font-medium text-cine-oro">
                    {movie.genreLabel}
                  </span>
                </div>

                <div>
                  <a
                    href={movie.trailerUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-block bg-cine-oro text-black font-bold px-6 py-2 rounded-lg transition-colors duration-200 hover:bg-white focus-visible:outline-black"
                  >
                    Ver Trailer
                  </a>
                </div>
              </div>
            </div>
          </SwiperSlide>
        ))}
      </SwiperWrapper>
      <SwiperButtonPrev />
      <SwiperButtonNext />
    </Swiper>
  )
}

{degraded && <AvisoDegradado />}
