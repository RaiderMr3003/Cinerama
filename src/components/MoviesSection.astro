---
// MoviesSection.astro
import { Calendar, Star } from "@lucide/astro";

import { getMovieList } from "../lib/movies";
import AvisoDegradado from "./AvisoDegradado.astro";

export interface Props {
  idsection?: string;
  title: string;
  subtitle: string;
  fetchUrl: string;
}

const { idsection, title, subtitle, fetchUrl } = Astro.props;

const { movies, degraded } = await getMovieList(fetchUrl, 20, "w780");
---

<section id={idsection} class="my-10 mx-7 text-white">
  <div class="container mx-auto px-6">
    <div class="text-center space-y-3 mb-10">
      <h1 class="text-3xl md:text-4xl lg:text-6xl font-bold">{title}</h1>
      <p>{subtitle}</p>
    </div>

    {degraded && <AvisoDegradado />}

    {
      movies.length === 0 ? (
        <p class="py-16 text-center text-gray-400">
          No hay películas disponibles por el momento.
        </p>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mt-8">
          {movies.map((movie) => (
            <div class="movie-card rounded-xl bg-slate-900 shadow-lg p-6 hover:shadow-2xl transition-all duration-300">
              <div class="h-64 rounded-lg mb-4 overflow-hidden">
                <img
                  src={movie.image}
                  class="w-full h-full object-cover"
                  alt={movie.title}
                  loading="lazy"
                  decoding="async"
                  width="780"
                  height="440"
                />
              </div>
              <div class="flex items-center text-gray-400 mb-2 gap-2">
                <h2 class="text-2xl font-bold line-clamp-2">{movie.title}</h2>
              </div>
              <div class="flex items-center mb-2 gap-4">
                <div class="flex items-center gap-1">
                  <span class="text-gray-400">{movie.releaseLabel}</span>
                  <Calendar size={20} class="text-green-300" />
                </div>
                <div class="flex items-center gap-1">
                  <span class="text-gray-400">{movie.ratingLabel}</span>
                  <Star size={20} class="text-yellow-300" />
                </div>
                <span class="bg-blue-600 px-2 py-1 rounded text-xs">
                  {movie.genreLabel}
                </span>
              </div>
              <p class="text-gray-300 line-clamp-4">
                {movie.overview || "Sin sinopsis disponible."}
              </p>
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
.movie-card:hover {
  transform: translateY(-8px) scale(1.02);
  box-shadow: 0 25px 50px -12px rgba(55, 55, 55, 0.5);
}
</style>
